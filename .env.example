# Copy to .env and change every value marked CHANGE-ME.
# .env is git-ignored. Never commit real secrets.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME
# 1 for local development only. Must be 0 on any shared server.
DJANGO_DEBUG=1
# Comma-separated. Add the server's LAN IP / hostname to test from a phone.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins, needed when served over HTTPS, e.g. https://hr.sanpascual.local
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 when served behind HTTPS (secure cookies, HTTPS redirect, HSTS). See README.
DJANGO_HTTPS=0
# Comma-separated list of reverse proxy IPs or CIDR subnets (e.g. Caddy/Nginx) trusted
# for X-Forwarded-For client IP extraction in audit logs.
TRUSTED_PROXIES=127.0.0.1,::1
# Optional: header a trusted proxy fills with the client IP, used instead of X-Forwarded-For.
# Railway: X-Real-IP (see README "Run it on Railway"). Leave empty behind Caddy/Nginx.
CLIENT_IP_HEADER=
# Prototype guard for the person FORM only: rejects ID numbers not starting with 00.
# Setting 0 does NOT allow real IDs: database constraints still reject them.
# See DECISIONS.md Go-Live Checklist item 1.
PROTOTYPE_FAKE_DATA_ONLY=1
# Employee age boundaries
MIN_EMPLOYEE_AGE=18
MAX_EMPLOYEE_AGE=90
# Days an unused one-time password (new account or reset) stays valid before HRMO must reissue it
ONE_TIME_PASSWORD_DAYS=14
# Salary actions tracker go-live: milestones before this date are assumed handled on paper.
SALARY_TRACKING_START=2026-10-01
SALARY_LOOKAHEAD_DAYS=90
# Contract renewals: list appointments ending within this many days.
RENEWAL_LOOKAHEAD_DAYS=45
# Upload file size limit in bytes (default 5 MB = 5242880)
MAX_UPLOAD_SIZE=5242880

# Which interface the web container listens on.
# 127.0.0.1 = this computer only. 0.0.0.0 = whole LAN (needed for phone testing).
WEB_BIND=127.0.0.1
# Host port for the site (default 8000).
# WEB_PORT=8000

# --- PostgreSQL ---
POSTGRES_DB=sanpascual_hr
# Owner role: runs migrations and tests only (the "manage" service).
POSTGRES_USER=hr_owner
POSTGRES_PASSWORD=CHANGE-ME
# App role: what the running website uses. Limited privileges (see docker/db-init).
APP_DB_USER=hr_app
APP_DB_PASSWORD=CHANGE-ME
